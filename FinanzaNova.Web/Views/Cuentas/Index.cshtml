@model List<CuentaSaldoViewModel>
@{
    ViewData["Title"] = "Cuentas";
    var culture = CultureInfo.GetCultureInfo("es-ES");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2 mb-0">Cuentas</h1>
    <a class="btn btn-primary" asp-action="Create">Nueva cuenta</a>
</div>

<div class="panel">
    @if (Model.Count == 0)
    {
        <p class="text-muted mb-0">No hay cuentas registradas.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr><th>Nombre</th><th>Tipo</th><th>Estado</th><th class="text-end">Saldo</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var cuenta in Model)
                {
                    <tr>
                        <td class="fw-semibold">@cuenta.Nombre</td>
                        <td>@cuenta.Tipo</td>
                        <td><span class="badge @(cuenta.Activa ? "text-bg-success" : "text-bg-secondary")">@(cuenta.Activa ? "Activa" : "Archivada")</span></td>
                        <td class="text-end">@cuenta.Saldo.ToString("C", culture)</td>
                        <td class="text-end table-actions">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@cuenta.Id">Detalle</a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@cuenta.Id">Editar</a>
                            <form asp-action="ToggleActiva" asp-route-id="@cuenta.Id" method="post">
                                <button class="btn btn-sm btn-outline-warning" type="submit">@(cuenta.Activa ? "Archivar" : "Reactivar")</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
