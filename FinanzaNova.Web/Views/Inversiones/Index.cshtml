@model List<Inversion>
@{
    ViewData["Title"] = "Inversiones";
    var culture = CultureInfo.GetCultureInfo("es-ES");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2 mb-0">Inversiones</h1>
    <a class="btn btn-primary" asp-action="Create">Nueva inversion</a>
</div>

<div class="panel">
    @if (Model.Count == 0)
    {
        <p class="text-muted mb-0">No hay inversiones registradas.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr><th>Nombre</th><th>Tipo</th><th>Cuenta de financiacion</th><th class="text-end">Invertido</th><th class="text-end">Valor actual</th><th class="text-end">Resultado</th><th>Estado</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var inversion in Model)
                {
                    var resultado = inversion.ValorActual - inversion.ImporteInvertido;
                    <tr>
                        <td class="fw-semibold">@inversion.Nombre</td>
                        <td>@inversion.Tipo</td>
                        <td>@(inversion.CuentaReferencia?.Nombre ?? "-")</td>
                        <td class="text-end">@inversion.ImporteInvertido.ToString("C", culture)</td>
                        <td class="text-end">@inversion.ValorActual.ToString("C", culture)</td>
                        <td class="text-end @(resultado >= 0 ? "text-success" : "text-danger")">@resultado.ToString("C", culture)</td>
                        <td><span class="badge @(inversion.Activa ? "text-bg-success" : "text-bg-secondary")">@(inversion.Activa ? "Activa" : "Archivada")</span></td>
                        <td class="text-end table-actions">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@inversion.Id">Editar</a>
                            <form asp-action="ToggleActiva" asp-route-id="@inversion.Id" method="post">
                                <button class="btn btn-sm btn-outline-warning" type="submit">@(inversion.Activa ? "Archivar" : "Reactivar")</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
