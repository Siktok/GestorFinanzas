@model List<Categoria>
@{
    ViewData["Title"] = "Categorias";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2 mb-0">Categorias</h1>
    <a class="btn btn-primary" asp-action="Create">Nueva categoria</a>
</div>

<div class="panel">
    @if (Model.Count == 0)
    {
        <p class="text-muted mb-0">No hay categorias registradas.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>Nombre</th><th>Tipo</th><th>Color</th><th>Estado</th><th></th></tr></thead>
                <tbody>
                @foreach (var categoria in Model)
                {
                    <tr>
                        <td class="fw-semibold">@categoria.Nombre</td>
                        <td>@categoria.Tipo</td>
                        <td><span class="color-swatch" style="background-color:@categoria.ColorHex"></span> @categoria.ColorHex</td>
                        <td><span class="badge @(categoria.Activa ? "text-bg-success" : "text-bg-secondary")">@(categoria.Activa ? "Activa" : "Archivada")</span></td>
                        <td class="text-end table-actions">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@categoria.Id">Editar</a>
                            <form asp-action="ToggleActiva" asp-route-id="@categoria.Id" method="post">
                                <button class="btn btn-sm btn-outline-warning" type="submit">@(categoria.Activa ? "Archivar" : "Reactivar")</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
