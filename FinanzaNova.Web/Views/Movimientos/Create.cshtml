@model Movimiento
@{
    ViewData["Title"] = "Nuevo movimiento";
}

<h1 class="h2 mb-4">Nuevo movimiento</h1>

<div class="panel form-panel">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Tipo" class="form-label"></label>
                <select asp-for="Tipo" asp-items="Html.GetEnumSelectList<MovimientoTipo>()" class="form-select"></select>
            </div>
            <div class="col-md-6">
                <label asp-for="Estado" class="form-label"></label>
                <select asp-for="Estado" asp-items="Html.GetEnumSelectList<MovimientoEstado>()" class="form-select"></select>
            </div>
            <div class="col-md-6">
                <label asp-for="CuentaId" class="form-label"></label>
                <select asp-for="CuentaId" asp-items="ViewBag.CuentaId" class="form-select">
                    <option value="">Selecciona cuenta</option>
                </select>
                <span asp-validation-for="CuentaId" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="CuentaDestinoId" class="form-label"></label>
                <select asp-for="CuentaDestinoId" asp-items="ViewBag.CuentaDestinoId" class="form-select">
                    <option value="">Solo transferencias</option>
                </select>
                <span asp-validation-for="CuentaDestinoId" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="CategoriaId" class="form-label"></label>
                <select asp-for="CategoriaId" asp-items="ViewBag.CategoriaId" class="form-select">
                    <option value="">Selecciona categoria</option>
                </select>
                <span asp-validation-for="CategoriaId" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Fecha" class="form-label"></label>
                <input asp-for="Fecha" class="form-control" type="date" />
            </div>
            <div class="col-md-8">
                <label asp-for="Descripcion" class="form-label"></label>
                <input asp-for="Descripcion" class="form-control" />
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Importe" class="form-label"></label>
                <input asp-for="Importe" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Importe" class="text-danger"></span>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button class="btn btn-primary" type="submit">Guardar</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
